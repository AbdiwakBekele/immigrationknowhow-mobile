{
  "expo": {
    "name": "IKH",
    "slug": "mobile-ikh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.immigrantknowhow.ikhapp",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "IKH needs camera access so users can take photos for profile pictures, documents, certificates, and service-related uploads.",
        "NSPhotoLibraryUsageDescription": "IKH needs photo library access so users can select and upload profile pictures, documents, certificates, and service-related images.",
        "NSPhotoLibraryAddUsageDescription": "IKH may save selected or processed images when required by the user.",
        "NSMicrophoneUsageDescription": "IKH may need microphone access if users record or upload videos with audio.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.immigrantknowhow.android",
      "versionCode": 10,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-font",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "IKH needs photo library access so users can select and upload profile pictures, documents, certificates, and service-related images.",
          "cameraPermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d1497186-9595-44d5-953e-20354d19112e"
      }
    },
    "owner": "georgeact",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d1497186-9595-44d5-953e-20354d19112e"
    }
  }
}
